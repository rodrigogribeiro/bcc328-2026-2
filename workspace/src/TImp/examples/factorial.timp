// Fatorial recursivo
fn factorial(n: int): int {
    if n == 0 {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

// Fatorial iterativo
fn factorialIter(n: int): int {
    var result : int = 1;
    var i : int = n;
    while i > 0 {
        result := result * i;
        i := i - 1;
    }
    return result;
}

var n : int = 0;
read "n: " n;
print factorial(n);
print factorialIter(n);
