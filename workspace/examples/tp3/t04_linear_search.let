-- Busca linear em array de inteiros (sem anotações nas variáveis locais)
let search = fn (arr : array(int), n : int, target : int) : int {
    let i := 0;
    while i < n {
        if arr[i] == target {
            return i;
        }
        i := i + 1;
    }
    return -1;
}

let main = fn (args : array(string)) : unit {
    let a := array_make(5, 0);
    a[0] := 10;
    a[1] := 23;
    a[2] := 5;
    a[3] := 42;
    a[4] := 17;
    let idx := search(a, 5, 42);
    print(int_to_string(idx));
    let idx2 := search(a, 5, 99);
    print(int_to_string(idx2));
}
