// Featherweight Java example: immutable pairs
//
// Usage in the REPL:
//   FJ> :load examples/pair.fj
//   FJ> new Pair(new A(), new B()).fst()
//   FJ> (A) new Pair(new A(), new B()).fst()

class A extends Object {
    A() { super(); }
}

class B extends Object {
    B() { super(); }
}

class Pair extends Object {
    Object fst;
    Object snd;

    Pair(Object fst, Object snd) {
        super();
        this.fst = fst;
        this.snd = snd;
    }

    Object fst() { return this.fst; }
    Object snd() { return this.snd; }

    Pair swap() { return new Pair(this.snd, this.fst); }
}

// main expression (ignored by :load, but required by the grammar)
new Object()
